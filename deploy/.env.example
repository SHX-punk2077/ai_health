# 复制为 .env 后按需修改：docker compose --env-file .env up -d
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=aihealth123
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=80

# JWT 密钥必须 >= 32 字节，生产环境务必替换
JWT_SECRET=please-change-me-to-a-32-bytes-secret

# ---------- AI（国内大模型优先）----------
# provider：mock 不调外部接口（开箱即用）；deepseek | qwen | glm | moonshot 为国内厂商
# 换厂商时 BASE_URL / MODEL 留空即可，服务端按 provider 预置：
#   deepseek   https://api.deepseek.com/v1                        deepseek-chat
#   qwen       https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   glm        https://open.bigmodel.cn/api/paas/v4               glm-4-flash
#   moonshot   https://api.moonshot.cn/v1                         moonshot-v1-8k
# 例：AI_PROVIDER=deepseek  AI_API_KEY=sk-xxxxxxxx
AI_PROVIDER=mock
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
