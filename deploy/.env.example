# 复制为 .env 后按需修改：docker compose --env-file .env up -d
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=aihealth123
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=80

# JWT 密钥必须 >= 32 字节，生产环境务必替换
JWT_SECRET=please-change-me-to-a-32-bytes-secret

# AI：mock 不调用外部接口；openai 需填 API_KEY
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
